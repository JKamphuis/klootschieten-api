# Klootschieten API — environment variables
# Copy to .env and adjust, or export directly in your shell / systemd unit.

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
DB_PATH=./data/matches.db

# ── CORS ─────────────────────────────────────────────────────────────────────
# Origins allowed to call the API from a browser (JS fetch / XHR).
# Use * to allow any origin (fine for read-only public data behind an API key).
# For tighter security list your actual domains, comma-separated:
#   CORS_ORIGIN=https://klootschieten.myclub.nl,https://www.myclub.nl
CORS_ORIGIN=*

# ── Bootstrap admin key ───────────────────────────────────────────────────────
# Set this ONCE on first startup to register your first admin key.
# Generate a good value:  openssl rand -hex 32
# REMOVE from environment after first run — it is not needed again.
ADMIN_KEY=replace-this-with-a-long-random-secret

# ── Scraping ──────────────────────────────────────────────────────────────────
# Cron schedule for automatic scraping (default: every Sunday at 23:00).
SCRAPE_CRON=0 23 * * 0

# Scrape immediately when the server starts (true/false)
SCRAPE_ON_START=false
